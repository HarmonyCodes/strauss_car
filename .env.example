# Copy to .env for local development. Never commit .env or real credentials.
APP_ENV=development
APP_NAME=strauss-car-advisor
DATABASE_URL=postgresql+asyncpg://REPLACE_ME
# Configure only when the selected ADK/model integration requires it.
GOOGLE_API_KEY=REPLACE_ME
# Set allowed origins explicitly; do not use wildcard origins with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173
