# Optional. Leave empty in development: Vite proxies "/api" to the backend.
# Set to the backend origin only when serving the built app from a different origin
# (the backend must then allow that origin via CORS).
VITE_API_BASE_URL=
# Backend address used by the Vite dev proxy.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
